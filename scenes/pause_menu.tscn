[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/pause_menu.gd" id="1_pause_script"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg_dim"]
bg_color = Color(0, 0, 0, 0.65)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pause_panel"]
bg_color = Color(0.04, 0.07, 0.12, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.2, 0.8, 1, 0.7)
