grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_crosshair")

[node name="BottomMargin" type="MarginContainer" parent="HUDContainer"]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -180.0
offset_top = -120.0
offset_right = 180.0
offset_bottom = -20.0
