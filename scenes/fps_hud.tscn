grow_vertical = 0

[node name="VBoxContainer" type="VBoxContainer" parent="HUDContainer/BottomMargin"]
layout_mode = 2
theme_override_constants/separation = 6
alignment = 2

[node name="WeaponLabel" type="Label" parent="HUDContainer/BottomMargin/VBoxContainer"]
